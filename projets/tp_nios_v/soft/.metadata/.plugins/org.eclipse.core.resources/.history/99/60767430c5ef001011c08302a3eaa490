#include <unistd.h> // for usleep

#include "system.h"
#include "altera_avalon_pio_regs.h"

#include <stdio.h>
useconds_t time = 500000;

int main (void)
{
	printf("Hello, world!\n");

	while(1){
		IOWR_ALTERA_AVALON_PIO_DATA(PIO_0_BASE, 1);
		usleep(time);

		IOWR_ALTERA_AVALON_PIO_DATA(PIO_0_BASE, 0);
		usleep(time);
	}
	return 0;
}
